{
  "singleQuote": true,
  "trailingComma": "none",
  "semi": false,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "endOfLine": "lf",

  "tailwindStylesheet": "./app/assets/css/main.css",
  "tailwindAttributes": ["class", ".*Class", ":class"]
}
